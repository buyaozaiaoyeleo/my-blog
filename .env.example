# 可选。不填也能跑：档案员会沿同一条 LangGraph 直接引用文章。
# 填上之后，成稿改由模型组织，工具调用仍然先检索档案。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 兼容 OpenAI 接口的中转可以改这里，例如 http://localhost:11434/v1
OPENAI_BASE_URL=

# 管理后台（默认账号 changxy / changxy）。前台无入口，访问 /admin。
ADMIN_USER=changxy
ADMIN_PASSWORD=changxy
ADMIN_SECRET=night-passage-admin-secret
